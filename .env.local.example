# Copy this file to .env.local (already gitignored via .env* in
# .gitignore — never commit real values) and fill in the real keys.
#
# Used by app/api/contact/route.ts — both Contact forms
# (POST /api/contact): GPT's redesigned enquiry form (contact-client.tsx)
# and the older "General Inquiry" component. Also used by
# app/api/opportunity/route.ts (POST /api/opportunity) — the shared
# Careers/Talent/Partnerships submission route (direct-to-inbox, no CRM,
# per Mohammad's decision 2026-09-19). No separate env vars needed for
# that route — same RESEND_API_KEY / CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL.

# REQUIRED. Get one at https://resend.com/api-keys (free tier is enough
# to test — no credit card, no domain verification needed to send from
# Resend's own onboarding@resend.dev sandbox sender).
RESEND_API_KEY=

# REQUIRED. No default/fallback on purpose: orgro.ca's own mailbox isn't
# active yet (Cloudflare Email Routing pending — see app/lib/site-config.ts),
# so a placeholder @orgro.ca or @oragrolglobal.com address would silently
# bounce every submission. Point this at a real inbox you control until
# the orgro.ca mailbox is live, e.g.:
CONTACT_TO_EMAIL=

# OPTIONAL. Defaults to Resend's own sandbox sender, which works
# immediately with just RESEND_API_KEY above. Once a sending domain is
# verified in Resend (https://resend.com/domains), set this to an
# address on that domain instead so the "From" name/address matches the
# Oragrol brand, e.g.:
# CONTACT_FROM_EMAIL="Oragrol Contact Form <contact@orgro.ca>"

# Used by app/api/cyber-health/route.ts (POST /api/cyber-health) — the
# Cyber Health Assessment's real completion step. Also requires
# RESEND_API_KEY and CONTACT_TO_EMAIL above (the client's PDF report is
# emailed via Resend, same as the Contact form).

# OPTIONAL. Without it, CRM sync is skipped (logged only) — the client
# still gets their PDF report either way, this only affects whether the
# lead also lands in HubSpot automatically. Create a Private App at
# HubSpot Settings -> Integrations -> Private Apps with scopes
# crm.objects.contacts.write and crm.objects.notes.write, then paste its
# access token here. Also used (same token, no new scopes needed) by
# app/api/newsletter/route.ts's best-effort HubSpot sync — see below.
HUBSPOT_ACCESS_TOKEN=

# Used by app/api/newsletter/route.ts (POST /api/newsletter) — the
# footer Newsletter signup form (app/components/site/footer.tsx).
#
# REQUIRED. Brevo is the actual send platform for the monthly briefing
# (list "Newsletter", id 3) — without this, signups honestly fail rather
# than claiming success. Create an API key at Brevo -> Settings -> SMTP
# & API -> API keys & MCP, then paste it here. HUBSPOT_ACCESS_TOKEN
# above is used too (best-effort CRM visibility only — a HubSpot hiccup
# never blocks a signup that already succeeded in Brevo).
BREVO_API_KEY=

# ---------------------------------------------------------------------
# Added 2026-10-22: every other setting the code reads. Names only, no
# values, never commit real values. Each group says where it is used.
# ---------------------------------------------------------------------

# Chat assistant and ODO scan AI (app/api/chat, app/lib/odo-*.ts).
ANTHROPIC_API_KEY=

# Bot check on the ODO scan form (app/components/site/odo-scan.tsx,
# app/lib/odo-gate.ts). Cloudflare Turnstile: public site key + secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ODO research sources (app/lib/odo-*.ts).
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GEOAPIFY_API_KEY=
HIBP_API_KEY=
TAVILY_API_KEY=
# Jev (TypeSafe) decision model; OPTIONAL, callers fall back if it is missing (app/lib/jev.ts).
TYPESAFE_API_KEY=

# Redis storage (Upstash): scan, report and CRM-retry state.
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=

# QStash queue (Upstash): retries and chat sweep. QSTASH_URL is OPTIONAL
# (regional endpoint; defaults to https://qstash.upstash.io).
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public origin QStash calls back to (app/lib/scope-qstash.ts).
SCOPE_CALLBACK_ORIGIN=

# Scheduled jobs (app/api/chat-sweep, app/api/odo/cron/abandoned).
CRON_SECRET=

# Admin endpoints (app/api/admin, app/api/odo/admin).
ADMIN_ACTION_SECRET=
ODO_ADMIN_KEY=
# OPTIONAL: has a built-in default in app/lib/odo-email.ts. Set only to
# change where ODO admin emails go.
ODO_ADMIN_EMAIL=

# My Scope emails (app/lib/scope-email.ts). OPTIONAL, has a default.
SCOPE_TO_EMAIL=

# ZM77 link (app/lib/odo-zm77.ts): where finished ODO reports are sent.
ZM77_BASE_URL=
ZM77_ORS4_KEY=
